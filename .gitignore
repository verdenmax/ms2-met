
# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
build/
dist/
*.egg

# ---------------- Editor / IDE / OS ----------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------- Mass-spec raw / cache / intermediate ----------------
*.mzML
*.mzML.idx
*.raw
*.dia.npz
*.npz
workspace/
.scratch/

# ---------------- Search engine outputs (large; never tracked) ----------------
*.parquet
*.qry.res
!tests/fixtures/**/*.qry.res
*.spectra
*.pep.xml
*.pepXML

# ---------------- Feature CSV / JSON / TSV produced by ms2-met ----------------
*.csv
*.tsv
*.json
!extract_common_config.ini.example
!tests/**/*.json
!tests/**/*.csv
!tests/**/*.tsv

# ---------------- Logs ----------------
*.log
*.[Ll][Oo][Gg]

# ---------------- Plots ----------------
*.png
*.pdf
*.svg
*.eps

# ---------------- ms2-met runtime artifacts ----------------
# runs/ 整体忽略，但保留每个 baseline 的 config.ini（人工 curated 输入）
runs/*
!runs/baseline_*/
runs/baseline_*/*
!runs/baseline_*/config.ini
# 锚定 /：只匹配项目根的 baseline_*/，不影响 runs/baseline_*/
/baseline_*/
result_*.csv
result.csv
ms2*.log

# ---------------- User-specific configs (commit *.example instead) ----------------
# 锚定 /：只匹配项目根的 config.ini，runs/baseline_*/config.ini 由上方白名单管理
/config.ini
/extract_*.ini
!extract_common_config.ini.example
# Neg-FDR variants are tracked (they're derived from the gitignored
# _pfind_diann templates via dual-FDR additions; sharing them across
# the team keeps neg-FDR experiments reproducible).
!/extract_*_neg05.ini
!/extract_*_neg10.ini
!/extract_*_neg15.ini
!/extract_*_neg20.ini
# clean (1% FDR) 模板也纳入跟踪，便于团队共享含 [contaminant] 等公共配置。
!/extract_*_pfind_diann.ini

# ---------------- AI / scratch / planning files ----------------
PLAN.md
PROJECT_INFO.md
NOTES.md
TODO.md

# Root-level ad-hoc test scripts (real tests live in tests/)
/test_*.py
/scratch_*.py

# brainstorm visual companion (local, not committed)
.superpowers/
