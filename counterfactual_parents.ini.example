[counterfactual_parents]
# Select one predeclared raw split. The tool never infers a split from paths.
dataset_split = label_dev_train
labeling = silac

# Authoritative, upstream-filtered PSM JSON produced by tools/extract_common.py.
# Its label_type=positive rows in dataset_split become parent candidates.
input_psms = ./datasets/all_label_psms.json

# CSV/TSV with exactly one row per raw and columns raw_title,dataset_split.
raw_split_table = ./datasets/raw_split_manifest.csv

# Parent eligibility for the current counterfactual v1 scientific scope.
min_length = 7
max_length = 40
require_tryptic_c_terminus = true
exclude_modified = true

output_psms = ./datasets/label_dev_train_prepared_parents.json
output_manifest = ./datasets/label_dev_train_prepared_parents.tsv
output_audit = ./datasets/label_dev_train_prepared_parents.audit.json
